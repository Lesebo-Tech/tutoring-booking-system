
@{
    ViewBag.Title = "Analytics";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Analytics - TutorBook</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            background: #fafbfc;
            color: #1f2937;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .sidebar {
            width: 240px;
            min-height: 100vh;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            padding: 30px 0;
            background: #fff;
            border-right: 1px solid #e5e7eb;
        }

        .brand {
            display: block;
            padding: 0 24px 30px;
            color: #111827;
            font-size: 1.3em;
            font-weight: 700;
            text-decoration: none;
        }

            .brand span {
                color: #4f46e5;
            }

        .sidebar nav {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: 4px;
        }

            .sidebar nav a {
                display: block;
                padding: 12px 24px;
                border-left: 3px solid transparent;
                color: #4b5563;
                font-size: .95em;
                font-weight: 500;
                text-decoration: none;
            }

                .sidebar nav a:hover {
                    background: #f3f4f6;
                }

                .sidebar nav a.active {
                    background: #eef2ff;
                    color: #4f46e5;
                    border-left-color: #4f46e5;
                    font-weight: 600;
                }

        .bottom-links {
            padding-top: 14px;
            border-top: 1px solid #e5e7eb;
        }

            .bottom-links a {
                display: block;
                padding: 12px 24px;
                color: #6b7280;
                font-size: .9em;
                text-decoration: none;
            }

                .bottom-links a.logout {
                    color: #ef4444;
                }

        .main {
            flex: 1;
            min-width: 0;
            padding: 24px 30px;
        }

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

            .page-heading h1 {
                margin: 0 0 4px;
                color: #111827;
                font-size: 24px;
            }

            .page-heading p {
                margin: 0;
                color: #6b7280;
                font-size: 13px;
            }

        .overview-tag {
            padding: 7px 12px;
            background: #eef2ff;
            color: #4f46e5;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 12px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 13px 16px;
        }

        .stat-label {
            color: #6b7280;
            font-size: 12px;
            font-weight: 600;
        }

        .stat-value {
            margin-top: 5px;
            font-size: 25px;
            font-weight: 750;
            color: #111827;
        }

        .confirmed .stat-value {
            color: #059669;
        }

        .pending .stat-value {
            color: #d97706;
        }

        .cancelled .stat-value {
            color: #dc2626;
        }

        .secondary-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

            .secondary-stats .stat-card {
                padding: 11px 16px;
            }

            .secondary-stats .stat-value {
                font-size: 21px;
            }

        .chart-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px 18px;
            min-width: 0;
        }

            .chart-card h3 {
                margin: 0 0 12px;
                font-size: 14px;
                font-weight: 700;
                color: #111827;
            }

        .chart-area {
            position: relative;
            height: 190px;
        }

            .chart-area.small {
                height: 165px;
            }

        .bottom-charts {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 14px;
        }

        .footer-note {
            margin-top: 12px;
            color: #9ca3af;
            font-size: 11px;
            text-align: right;
        }

        @@media (max-width: 1100px) {
            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 800px) {
            .sidebar {
                width: 190px;
            }

            .main {
                padding: 18px;
            }

            .bottom-charts {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            body {
                display: block;
            }

            .sidebar {
                width: 100%;
                min-height: auto;
            }

            .main {
                padding: 14px;
            }

            .stat-grid,
            .secondary-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .page-heading h1 {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>
    <aside class="sidebar">
        <a href="@Url.Action("Index", "Home")"
           class="brand">
            Tutor<span>Book</span>
        </a>

        <nav>
            <a href="@Url.Action("Index", "Bookings")">
                My Bookings
            </a>

            <a href="@Url.Action("Index", "TimeSlots")">
                Manage Sessions
            </a>

            <a href="@Url.Action("Calendar", "TimeSlots")">
                Availability Calendar
            </a>

            <a href="@Url.Action("Analytics", "Bookings")"
               class="active">
                Analytics
            </a>
        </nav>

        <div class="bottom-links">
            <a href="@Url.Action("Index", "Home")">
                ← Back to Home
            </a>

            <a href="@Url.Action("Logout", "Account")"
               class="logout">
                Logout
            </a>
        </div>
    </aside>

    <main class="main">
        <div class="page-heading">
            <div>
                <h1>Analytics Dashboard</h1>
                <p>Monitor your tutoring bookings and performance.</p>
            </div>

            <span class="overview-tag">Overview</span>
        </div>

        <!-- Main statistics -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Total Bookings</div>
                <div class="stat-value">
                    @ViewBag.TotalBookings
                </div>
            </div>

            <div class="stat-card confirmed">
                <div class="stat-label">Confirmed</div>
                <div class="stat-value">
                    @ViewBag.ConfirmedCount
                </div>
            </div>

            <div class="stat-card pending">
                <div class="stat-label">Pending</div>
                <div class="stat-value">
                    @ViewBag.PendingCount
                </div>
            </div>

            <div class="stat-card cancelled">
                <div class="stat-label">Cancelled</div>
                <div class="stat-value">
                    @ViewBag.CancelledCount
                </div>
            </div>
        </div>

        <!-- Secondary statistics -->
        <div class="secondary-stats">
            <div class="stat-card">
                <div class="stat-label">Paid Sessions</div>
                <div class="stat-value">
                    @ViewBag.PaidSessions
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Unpaid (Confirmed)</div>
                <div class="stat-value">
                    @ViewBag.UnpaidSessions
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Sessions This Month</div>
                <div class="stat-value">
                    @ViewBag.SessionsThisMonth
                </div>
            </div>
        </div>

        <!-- Main chart -->
        <div class="chart-card">
            <h3>Bookings Over Last 6 Months</h3>

            <div class="chart-area">
                <canvas id="lineChart"></canvas>
            </div>
        </div>

        <!-- Two charts side by side -->
        <div class="bottom-charts">
            <div class="chart-card">
                <h3>Bookings by Subject</h3>

                <div class="chart-area small">
                    <canvas id="subjectChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <h3>Bookings by Status</h3>

                <div class="chart-area small">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>

        <div class="footer-note">
            TutorBook · Booking Analytics
        </div>
    </main>

    <script>
        // Data supplied by BookingsController.Analytics()

const monthlyLabels = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.MonthlyLabels)))');
const monthlyCounts = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.MonthlyCounts)))');

const subjectLabels = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.SubjectLabelsJson)))');
const subjectCounts = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.SubjectCountsJson)))');

const statusLabels = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.StatusLabels)))');
const statusCounts = JSON.parse('@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.StatusCounts)))');

        Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
        Chart.defaults.color = '#6b7280';

        // Monthly bookings line chart
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Bookings',
                    data: monthlyCounts,
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99,102,241,0.10)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    borderWidth: 2.5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            stepSize: 1
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Subject distribution doughnut chart
        new Chart(document.getElementById('subjectChart'), {
            type: 'doughnut',
            data: {
                labels: subjectLabels,
                datasets: [{
                    data: subjectCounts,
                    backgroundColor: [
                        '#4f46e5',
                        '#818cf8',
                        '#a5b4fc',
                        '#c7d2fe',
                        '#ddd6fe'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            boxWidth: 10,
                            padding: 10,
                            font: { size: 11 }
                        }
                    }
                }
            }
        });

        // Booking status doughnut chart

const statusColors = statusLabels.map(function (status) {
    var name = String(status).toLowerCase();

    if (name === 'confirmed') {
        return '#10b981';
    }

    if (name === 'pending') {
        return '#f59e0b';
    }

    if (name === 'cancelled') {
        return '#ef4444';
    }

    return '#6366f1';
});


        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusCounts,
                    backgroundColor: statusColors,
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            boxWidth: 10,
                            padding: 10,
                            font: { size: 11 }
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>
